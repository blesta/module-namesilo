        <?php
        $this->Widget->clear();
        $this->Widget->setLinkButtons($link_buttons);
        $this->Widget->create($this->_('Dynadot.manage.box_title', true));
        ?>
        <div class="title_row first">
            <h3><?php $this->_('Dynadot.manage.title'); ?></h3>
        </div>
        <?php
        $num_rows = count($module->rows ?? []);
        if ($num_rows > 0) {
            ?>
            <table class="table">
                <tr class="heading_row">
                    <td><span><?php $this->_('Dynadot.manage.module_row_title'); ?></span></td>
                    <td class="last"><span><?php $this->_('Dynadot.manage.module_groups_title'); ?></span></td>
                    <td class="last"><span><?php $this->_('Dynadot.manage.module_rows_options'); ?></span></td>
                </tr>
                <?php
                for ($i = 0; $i < $num_rows; $i++) {
                    ?>
                    <tr<?php echo ($i % 2 == 1) ? ' class="odd_row"' : ''; ?>>
                        <td><?php echo (isset($module->rows[$i]->meta->key) ? $this->Html->safe($module->rows[$i]->meta->key) : null); ?></td>
                        <td><?php echo $this->Html->safe(count($module->rows[$i]->groups ?? [])); ?></td>
                        <td>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/company/modules/editrow/' . (isset($module->id) ? $module->id : null) . '/' . (isset($module->rows[$i]->id) ? $module->rows[$i]->id : null) . '/'); ?>"><?php $this->_('Dynadot.manage.module_rows.edit'); ?></a>
                            <?php
                            $this->Form->create($this->base_uri . 'settings/company/modules/deleterow/' . (isset($module->id) ? $module->id : null) . '/' . (isset($module->rows[$i]->id) ? $module->rows[$i]->id : null) . '/');
                            $this->Form->fieldHidden('id', (isset($module->id) ? $module->id : null));
                            $this->Form->fieldHidden('row_id', (isset($module->rows[$i]->id) ? $module->rows[$i]->id : null));
                            ?>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/company/modules/deleterow/' . (isset($module->id) ? $module->id : null) . '/' . (isset($module->rows[$i]->id) ? $module->rows[$i]->id : null) . '/'); ?>" class="manage" rel="<?php echo $this->Html->safe($this->_('Dynadot.manage.module_rows.confirm_delete', true)); ?>"><?php $this->_('Dynadot.manage.module_rows.delete'); ?></a>
                            <?php
                            $this->Form->end();
                            ?>
                        </td>
                    </tr>
                    <?php
                }
                ?>
            </table>
            <?php
        } else {
            ?>
            <div class="empty_section">
                <div class="empty_box">
                    <?php $this->_('Dynadot.manage.module_rows_no_results'); ?>
                </div>
            </div>
            <?php
        }
        $this->Widget->end();
        ?>
