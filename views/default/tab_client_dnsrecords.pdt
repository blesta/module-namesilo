    </div>

    <script type="text/javascript">
        $(document).ready(function() {
            var root = $('#dns-records');
            if (root.data('dns-bound')) {
                return;
            }
            root.data('dns-bound', true);

            var base_url = <?php echo json_encode($this->base_uri); ?>;
            var panel = $('#dns-record-edit');
            var save = $('#dns_edit_save');
            var original = {};

            // Confirm deletes with Blesta's confirmation dialog
            $('a.dns-record-delete[rel]', root).blestaModalConfirm({
                base_url: base_url,
                title: <?php echo json_encode($this->_('Namesilo.tab_dnsrecord.title_delete', true)); ?>,
                submit: true
            });

            // Show the priority field only for MX records
            $('#dns_add_record_type').on('change', function() {
                $('#dns_add_distance_group').toggle($(this).val() === 'MX');
            });

            function format(template) {
                var args = Array.prototype.slice.call(arguments, 1);
                return template.replace(/%(\d)\$s/g, function(match, index) {
                    return args[index - 1];
                });
            }

            function display(value) {
                return value === '' ? panel.data('text-empty') : '"' + value + '"';
            }

            function currentValues() {
                return {
                    host: $.trim($('#dns_edit_host').val()).toLowerCase().replace(/^@$/, ''),
                    value: $.trim($('#dns_edit_value').val()),
                    distance: original.type === 'MX' ? $.trim($('#dns_edit_distance').val()) : '',
                    ttl: $.trim($('#dns_edit_ttl').val())
                };
            }

            // Describe the pending change and only allow saving when something changed
            function refreshSave() {
                var current = currentValues();
                var domain = panel.data('domain');
                var changes = [];

                $.each(['host', 'value', 'distance', 'ttl'], function(i, field) {
                    if (current[field] !== original[field]) {
                        var from = original[field];
                        var to = current[field];
                        if (field === 'host') {
                            from = from === '' ? domain : from + '.' + domain;
                            to = to === '' ? domain : to + '.' + domain;
                        }
                        changes.push(format(panel.data('text-change'), panel.data('label-' + field), display(from), display(to)));
                    }
                });

                var host = original.host === '' ? domain : original.host + '.' + domain;
                var message = format(panel.data('text-confirm'), original.type, host) + ' ' + changes.join('; ');

                // blestaModalConfirm reads the message when bound, so re-bind with the current one
                save.off('click').toggleClass('disabled', changes.length === 0).attr('rel', message);
                if (changes.length > 0) {
                    save.blestaModalConfirm({
                        base_url: base_url,
                        title: <?php echo json_encode($this->_('Namesilo.tab_dnsrecord.title_confirm_edit', true)); ?>,
                        submit: true
                    });
                } else {
                    save.on('click', function() {
                        return false;
                    });
                }
            }

            $('.dns-record-edit', root).on('click', function() {
                var button = $(this);
                original = {
                    type: String(button.data('type')),
                    host: String(button.attr('data-host')),
                    value: String(button.attr('data-value')),
                    distance: String(button.attr('data-distance')),
                    ttl: String(button.attr('data-ttl'))
                };

                $('#dns_edit_record_id').val(button.attr('data-record-id'));
                $('#dns_edit_record_type').val(original.type);
                $('#dns_edit_type_label').text(original.type);
                $('#dns_edit_host').val(original.host);
                $('#dns_edit_value').val(original.value);
                $('#dns_edit_distance').val(original.distance);
                $('#dns_edit_ttl').val(original.ttl);
                $('#dns_edit_distance_group').toggle(original.type === 'MX');

                refreshSave();
                panel.show();
                $('html, body').animate({scrollTop: panel.offset().top - 80}, 200);
                $('#dns_edit_value').focus();
            });

            $('input', panel).on('input change', refreshSave);

            $('#dns_edit_cancel').on('click', function() {
                panel.hide();
            });
        });
    </script>
