                </div>

                <div class="d-inline-block mx-1 mb-1" id="dns_edit_distance_group" style="display:none;">
                    <label for="dns_edit_distance"><?php $this->_('Namesilo.dnsrecord.distance'); ?></label>
                    <?php $this->Form->fieldText('distance', null, ['class' => 'form-control', 'id' => 'dns_edit_distance']); ?>
                </div>

                <div class="d-inline-block mx-1 mb-1">
                    <label for="dns_edit_ttl"><?php $this->_('Namesilo.dnsrecord.ttl'); ?></label>
                    <?php $this->Form->fieldText('ttl', null, ['class' => 'form-control', 'id' => 'dns_edit_ttl']); ?>
                </div>
            </div>

            <div class="float-right">
                <button class="btn btn-light" type="button" id="dns_edit_cancel">
                    <?php $this->_('Namesilo.tab_dnsrecord.field_cancel'); ?>
                </button>
                <button class="btn btn-success" type="submit" name="action" value="updateDnsRecord">
                    <i class="fas fa-save"></i> <?php $this->_('Namesilo.tab_dnsrecord.field_save'); ?>
                </button>
            </div>
            <div class="clearfix"></div>
            <?php $this->Form->end(); ?>
        </div>

        <h4 class="mt-3"><?php $this->_('Namesilo.tab_dnsrecord.title_add'); ?></h4>
        <?php $this->Form->create($dns_form_uri); ?>
        <div class="form-group">
            <div class="d-inline-block mx-1 mb-1">
                <label><?php $this->_('Namesilo.dnsrecord.record_type'); ?></label>
                <?php $this->Form->fieldSelect('record_type', $vars->selects['record_type']['options'], null, [
                    'class' => 'form-control',
                    'id' => 'dns_add_record_type',
                ]); ?>
            </div>

            <div class="d-inline-block mx-1 mb-1">
                <div class="d-inline-block">
                    <label class="m-0"><?php $this->_('Namesilo.dnsrecord.host'); ?></label>
                    <?php $this->Form->fieldText('host', null, ['class' => 'form-control']); ?>
                </div>
                <div class="d-inline-block">.<?php echo $this->Html->safe($fields->domain ?? ''); ?></div>
            </div>

            <div class="d-inline-block mx-1 mb-1">
                <label><?php $this->_('Namesilo.dnsrecord.value'); ?></label>
                <?php $this->Form->fieldText('value', null, ['class' => 'form-control']); ?>
            </div>

            <div class="d-inline-block mx-1 mb-1" id="dns_add_distance_group" style="display:none;">
                <label><?php $this->_('Namesilo.dnsrecord.distance'); ?></label>
                <?php $this->Form->fieldText('distance', 10, ['class' => 'form-control']); ?>
            </div>

            <div class="d-inline-block mx-1 mb-1">
                <label><?php $this->_('Namesilo.dnsrecord.ttl'); ?></label>
                <?php $this->Form->fieldText('ttl', 7207, ['class' => 'form-control']); ?>
            </div>
        </div>

        <button class="btn btn-light float-right" type="submit" name="action" value="addDnsRecord">
            <i class="fas fa-plus"></i> <?php $this->_('Namesilo.tab_dnsrecord.field_add'); ?>
        </button>
        <?php $this->Form->end(); ?>
    </div>

    <script>
        (function () {
            function ready(fn) {
                if (document.readyState !== 'loading') {
                    fn();
                } else {
                    document.addEventListener('DOMContentLoaded', fn);
                }
            }

            ready(function () {
                var root = document.getElementById('dns-records');
                if (!root || root.getAttribute('data-dns-bound')) {
                    return;
                }
                root.setAttribute('data-dns-bound', '1');

                var panel = document.getElementById('dns-record-edit');
                var addType = document.getElementById('dns_add_record_type');
                var addDistance = document.getElementById('dns_add_distance_group');

                // Show the priority field only for MX records
                addType.addEventListener('change', function () {
                    addDistance.style.display = this.value === 'MX' ? '' : 'none';
                });

                root.querySelectorAll('.dns-record-edit').forEach(function (button) {
                    button.addEventListener('click', function () {
                        var type = this.getAttribute('data-type');
                        document.getElementById('dns_edit_record_id').value = this.getAttribute('data-record-id');
                        document.getElementById('dns_edit_record_type').value = type;
                        document.getElementById('dns_edit_type_label').textContent = type;
                        document.getElementById('dns_edit_host').value = this.getAttribute('data-host');
                        document.getElementById('dns_edit_value').value = this.getAttribute('data-value');
                        document.getElementById('dns_edit_distance').value = this.getAttribute('data-distance');
                        document.getElementById('dns_edit_ttl').value = this.getAttribute('data-ttl');
                        document.getElementById('dns_edit_distance_group').style.display = type === 'MX' ? '' : 'none';
                        panel.style.display = '';
                        panel.scrollIntoView({behavior: 'smooth', block: 'center'});
                        document.getElementById('dns_edit_value').focus();
                    });
                });

                document.getElementById('dns_edit_cancel').addEventListener('click', function () {
                    panel.style.display = 'none';
                });

                root.querySelectorAll('.dns-record-delete').forEach(function (form) {
                    form.addEventListener('submit', function (e) {
                        if (!window.confirm(this.getAttribute('data-confirm'))) {
                            e.preventDefault();
                        }
                    });
                });
            });
        })();
    </script>
