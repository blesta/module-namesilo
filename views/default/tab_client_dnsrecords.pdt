    <div class="row panel-fix">
        <div class="col-md-12">
            <h4><?php $this->_('Dynadot.tab_dnsrecords.title');?></h4>
            <div class="alert alert-warning">
                <p><?php $this->_('Dynadot.tab_dnsrecords.warning_overwrite');?></p>
            </div>

            <?php
            $this->Form->create();
            ?>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th><?php $this->_('Dynadot.dnsrecord.record_type');?></th>
                        <th><?php $this->_('Dynadot.dnsrecord.host');?></th>
                        <th><?php $this->_('Dynadot.dnsrecord.value');?></th>
                    </tr>
                </thead>
                <tbody>
                    <?php
                    for ($i=0; $i<5; $i++) {
                    ?>
                    <tr>
                        <td>
                            <?php $this->Form->fieldSelect('main_record_type' . $i, $vars->record_types ?? [], $vars->{'main_record_type' . $i} ?? null, ['class' => 'form-control']); ?>
                        </td>
                        <td>
                            <?php $this->Form->fieldText('subdomain' . $i, $vars->{'subdomain' . $i} ?? '', ['class' => 'form-control']); ?>
                        </td>
                        <td>
                            <?php $this->Form->fieldText('main_record' . $i, $vars->{'main_record' . $i} ?? '', ['class' => 'form-control']); ?>
                        </td>
                    </tr>
                    <?php
                    }
                    ?>
                </tbody>
            </table>
            <div class="button_row">
                <?php $this->Form->fieldSubmit('save', $this->_('Dynadot.tab_dnsrecords.field_submit', true), ['class' => 'btn btn-primary pull-right']); ?>
            </div>
            <?php
            $this->Form->end();
            ?>
        </div>
    </div>
