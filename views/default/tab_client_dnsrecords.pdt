                                <td><?php echo $this->Html->safe($distance); ?></td>
                                <td><?php echo $this->Html->safe($record['ttl'] ?? null); ?></td>
                                <td class="text-nowrap">
                                    <button type="button" class="btn btn-sm btn-light dns-record-edit"
                                        data-record-id="<?php echo $this->Html->safe($record['record_id'] ?? ''); ?>"
                                        data-type="<?php echo $this->Html->safe($record['type'] ?? ''); ?>"
                                        data-host="<?php echo $this->Html->safe($record['edit_host'] ?? ''); ?>"
                                        data-value="<?php echo $this->Html->safe($record['value'] ?? ''); ?>"
                                        data-distance="<?php echo $this->Html->safe($distance ?? ''); ?>"
                                        data-ttl="<?php echo $this->Html->safe($record['ttl'] ?? ''); ?>">
                                        <i class="fas fa-edit"></i> <?php $this->_('Namesilo.tab_dnsrecord.field_edit'); ?>
                                    </button>
                                    <?php
                                    $this->Form->create($dns_form_uri, [
                                        'class' => 'd-inline-block dns-record-delete',
                                        'data-confirm' => $this->_('Namesilo.tab_dnsrecord.confirm_delete', true),
                                    ]);
                                    $this->Form->fieldHidden('record_id', $record['record_id'] ?? null);
                                    $this->Form->fieldButton(
                                        'action',
                                        $this->_('Namesilo.tab_dnssec.field_delete', true),
                                        ['class' => 'btn btn-sm btn-danger', 'value' => 'deleteDnsRecord', 'type' => 'submit']
                                    );
                                    $this->Form->end();
                                    ?>
                                </td>
                            </tr>
                            <?php
                        }
                    } ?>
                </tbody>
            </table>
        </div>

        <div id="dns-record-edit" class="mt-3" style="display:none;">
            <h4><?php $this->_('Namesilo.tab_dnsrecord.title_edit'); ?></h4>
            <?php $this->Form->create($dns_form_uri); ?>
