            <?php $this->Form->fieldHidden('record_type', null, ['id' => 'dns_edit_record_type']); ?>
            <div class="form-group">
                <div class="d-inline-block mx-1 mb-1">
                    <label><?php $this->_('Namesilo.dnsrecord.record_type'); ?></label>
                    <p class="form-control-plaintext" id="dns_edit_type_label"></p>
                </div>

                <div class="d-inline-block mx-1 mb-1">
                    <div class="d-inline-block">
                        <label class="m-0" for="dns_edit_host"><?php $this->_('Namesilo.dnsrecord.host'); ?></label>
                        <?php $this->Form->fieldText('host', null, ['class' => 'form-control', 'id' => 'dns_edit_host']); ?>
                    </div>
                    <div class="d-inline-block">.<?php echo $this->Html->safe($fields->domain ?? ''); ?></div>
                </div>

                <div class="d-inline-block mx-1 mb-1">
                    <label for="dns_edit_value"><?php $this->_('Namesilo.dnsrecord.value'); ?></label>
