    <div class="row panel-fix">
        <div class="col-md-12">
            <h4><?php $this->_('Dynadot.tab_email_forwarding.title');?></h4>
            <div class="alert alert-warning">
                <p><?php $this->_('Dynadot.tab_email_forwarding.warning_overwrite');?></p>
            </div>

            <?php
            $this->Form->create();
            ?>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th><?php $this->_('Dynadot.email_forwarding.username');?></th>
                        <th><?php $this->_('Dynadot.email_forwarding.destination');?></th>
                    </tr>
                </thead>
                <tbody>
                    <?php
                    for ($i=0; $i<5; $i++) {
                    ?>
                    <tr>
                        <td>
                            <?php $this->Form->fieldText('username' . $i, $vars->{'username' . $i} ?? '', ['class' => 'form-control']); ?>
                        </td>
                        <td>
                            <?php $this->Form->fieldText('exist_email' . $i, $vars->{'exist_email' . $i} ?? '', ['class' => 'form-control']); ?>
                        </td>
                    </tr>
                    <?php
                    }
                    ?>
                </tbody>
            </table>
            <div class="button_row">
                <?php $this->Form->fieldSubmit('save', $this->_('Dynadot.tab_email_forwarding.field_submit', true), ['class' => 'btn btn-primary pull-right']); ?>
            </div>
            <?php
            $this->Form->end();
            ?>
        </div>
    </div>
