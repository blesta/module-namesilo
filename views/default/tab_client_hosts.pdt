    <div class="row panel-fix">
        <div class="col-md-12">
            <h4><?php $this->_('Dynadot.tab_hosts.title');?></h4>
            <?php
            $this->Form->create();
            ?>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th><?php $this->_('Dynadot.tab_hosts.field_hostname');?></th>
                        <th><?php $this->_('Dynadot.tab_hosts.field_ip');?></th>
                        <th><?php $this->_('Dynadot.tab_hosts.field_submit');?></th>
                    </tr>
                </thead>
                <tbody>
                    <?php
                    if (isset($vars->hosts) && is_array($vars->hosts)) {
                        foreach ($vars->hosts as $host) {
                            ?>
                            <tr>
                                <td><?php echo $this->Html->safe($host->host ?? '');?></td>
                                <td><?php echo $this->Html->safe($host->ip ?? '');?></td>
                                <td>
                                    <a href="<?php echo $this->Html->safe($this->base_uri . 'clients/servicetab/' . (isset($client_id) ? $client_id : null) . '/' . (isset($service_id) ? $service_id : null) . '/tabClientHosts/?action=delete&host=' . ($host->host ?? ''));?>" class="btn btn-sm btn-danger"><?php $this->_('Dynadot.tab_hosts.field_delete');?></a>
                                </td>
                            </tr>
                            <?php
                        }
                    }
                    ?>
                    <tr>
                        <td>
                            <?php $this->Form->fieldText('host', $vars->new_host ?? '', ['class' => 'form-control']); ?>
                        </td>
                        <td>
                            <?php $this->Form->fieldText('ip', $vars->new_ip ?? '', ['class' => 'form-control']); ?>
                        </td>
                        <td>
                            <?php $this->Form->fieldSubmit('save', $this->_('Dynadot.tab_hosts.field_add', true), ['class' => 'btn btn-primary']); ?>
                        </td>
                    </tr>
                </tbody>
            </table>
            <?php
            $this->Form->end();
            ?>
        </div>
    </div>
