    <div class="row panel-fix">
        <div class="col-md-12">
            <h4><?php $this->_('Dynadot.tab_nameservers.title');?></h4>
            <div class="form-group">
                <?php
                for ($i = 0; $i < 5; $i++) {
                    ?>
                    <div class="form-group">
                        <?php
                        $this->Form->label($this->_('Dynadot.tab_nameservers.field_ns', true, $i + 1), 'ns' . ($i + 1));
                        $this->Form->fieldText('ns[]', (isset($vars->ns[$i]) ? $vars->ns[$i] : null), ['id' => 'ns' . ($i + 1), 'class' => 'form-control']);
                        ?>
                    </div>
                    <?php
                }
                ?>
            </div>
        </div>
    </div>
    <div class="button_row">
        <?php
        $this->Form->fieldSubmit('save', $this->_('Dynadot.tab_nameservers.field_submit', true), ['class' => 'btn btn-primary pull-right']);
        ?>
    </div>
