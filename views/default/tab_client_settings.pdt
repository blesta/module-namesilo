    <div class="row panel-fix">
        <div class="col-md-12">
            <h4><?php $this->_('Dynadot.tab_settings.title');?></h4>

            <div class="form-group">
                <?php
                $this->Form->label($this->_('Dynadot.tab_settings.field_registrar_lock', true), 'registrar_lock');
                ?>
                <div class="radio">
                    <label>
                        <?php
                        $this->Form->fieldRadio('registrar_lock', 'yes', (isset($vars->registrar_lock) ? $vars->registrar_lock : null) == 'yes', ['id' => 'registrar_lock_yes']);
                        $this->_('Dynadot.tab_settings.field_registrar_lock_yes');
                        ?>
                    </label>
                </div>
                <div class="radio">
                    <label>
                        <?php
                        $this->Form->fieldRadio('registrar_lock', 'no', (isset($vars->registrar_lock) ? $vars->registrar_lock : null) == 'no', ['id' => 'registrar_lock_no']);
                        $this->_('Dynadot.tab_settings.field_registrar_lock_no');
                        ?>
                    </label>
                </div>
            </div>
            <div class="button_row">
                <?php
                $this->Form->fieldSubmit('save', $this->_('Dynadot.tab_settings.field_submit', true), ['class' => 'btn btn-primary pull-right']);
                ?>
            </div>

            <hr />

            <div class="form-group">
                <?php
                $this->Form->label($this->_('Dynadot.tab_settings.field_request_epp', true), 'request_epp');
                $this->Form->fieldCheckbox('request_epp', 'true', (isset($vars->request_epp) ? $vars->request_epp : null) == 'true', ['id' => 'request_epp']);
                ?>
            </div>
            <div class="button_row">
                <?php
                $this->Form->fieldSubmit('save', $this->_('Dynadot.tab_settings.field_submit', true), ['class' => 'btn btn-primary pull-right']);
                ?>
            </div>
        </div>
    </div>
    <?php
    $this->Form->end();
    ?>
