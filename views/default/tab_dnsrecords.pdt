<?php /** @var View $this **/ ?>

<div id="dns-records">
    <h6 class="form-section-header first"><?php $this->_('Namesilo.tab_dnsrecord.title_list'); ?></h6>
    <p class="text-muted"><?php $this->_('Namesilo.tab_dnsrecord.help_text_1'); ?></p>
    <table class="table">
        <thead>
            <tr>
                <th><span><?php $this->_('Namesilo.dnsrecord.record_type'); ?></span></th>
                <th><span><?php $this->_('Namesilo.dnsrecord.host'); ?></span></th>
                <th><span><?php $this->_('Namesilo.dnsrecord.value'); ?></span></th>
                <th><span><?php $this->_('Namesilo.dnsrecord.distance'); ?></span></th>
                <th><span><?php $this->_('Namesilo.dnsrecord.ttl'); ?></span></th>
                <th><span><?php $this->_('Namesilo.dnsrecord.field_delete'); ?></span></th>
            </tr>
        </thead>
        <tbody>
            <?php if (count($vars->records) > 0 && isset($vars->records)) {
                $i = 0;
                foreach ($vars->records as $record) { ?>
            <tr>
                <td><?php echo $this->Html->safe($record['type'] ?? null); ?></td>
                <td><?php echo $this->Html->safe($record['host'] ?? null); ?></td>
                <td><?php echo $this->Html->safe($record['value'] ?? null); ?></td>
                <td><?php echo isset($record['distance']) && $record['distance'] != 0
                    ? $this->Html->safe($record['distance'])
                    : null; ?></td>
                <td><?php echo $this->Html->safe($record['ttl'] ?? null); ?></td>
                <td>
                    <?php
                    $this->Form->create(
                        $this->base_uri .
                            'clients/servicetab/' .
                            ($client_id ?? null) .
                            '/' .
                            ($service_id ?? null) .
                            '/tabDnsRecords/',
                    );
                    $this->Form->fieldHidden('record_id', $record['record_id'] ?? null);

                    $button_attributes = [
                        'class' => 'btn btn-sm btn-outline-danger',
                        'value' => 'deleteDnsRecord',
                        'type' => 'submit',
                    ];

                    $this->Form->fieldButton(
                        'action',
                        $this->_('Namesilo.tab_dnssec.field_delete', true),
                        $button_attributes,
                    );

                    $this->Form->end();
                    ?>
                </td>
            </tr>
                    <?php $i++;
                }
            } ?>
        </tbody>
    </table>

    <h6 class="form-section-header"><?php $this->_('Namesilo.tab_dnsrecord.title_add'); ?></h6>
                    <?php $this->Form->create(
                        $this->base_uri .
                            'clients/servicetab/' .
                            ($client_id ?? null) .
                            '/' .
                            ($service_id ?? null) .
                            '/tabDnsRecords/',
                    ); ?>
    <table class="table">
        <!-- Add New DNS Record -->
        <thead>
            <tr>
                <th><span><?php $this->_('Namesilo.dnsrecord.record_type'); ?></span></th>
                <th><span><?php $this->_('Namesilo.dnsrecord.host'); ?></span></th>
                <th><span><?php $this->_('Namesilo.dnsrecord.value'); ?></span></th>
                <th class="distance" style="display:none;"><span><?php $this->_(
                    'Namesilo.dnsrecord.distance',
                ); ?></span></th>
                <th><span><?php $this->_('Namesilo.dnsrecord.ttl'); ?></span></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><?php $this->Form->fieldSelect('record_type', $vars->selects['record_type']['options'], '', [
                    'class' => 'form-select',
                ]); ?></td>
                <td><?php $this->Form->fieldText('host', '', ['class' => 'form-control']); ?></td>
                <td><?php $this->Form->fieldText('value', '', ['class' => 'form-control']); ?></td>
                <td class="distance" style="display:none;"><?php $this->Form->fieldText('distance', 10, [
                    'class' => 'form-control',
                ]); ?></td>
                <td><?php $this->Form->fieldText('ttl', 7207, ['class' => 'form-control']); ?></td>
                <td>
                    <?php
                    $button_attributes = [
                        'class' => 'btn btn-primary',
                        'value' => 'addDnsRecord',
                        'type' => 'submit',
                    ];

                    $this->Form->fieldButton(
                        'action',
                        $this->_('Namesilo.tab_dnsrecord.field_add', true),
                        $button_attributes,
                    );
                    ?>
                </td>

            </tr>
        </tbody>
    </table>
                    <?php $this->Form->end(); ?>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('[name="record_type"]').forEach(function(el) {
            el.addEventListener('change', function() {
                var display = this.value === 'MX' ? '' : 'none';
                document.querySelectorAll('.distance').forEach(function(d) {
                    d.style.display = display;
                });
            });
        });
    });
</script>
