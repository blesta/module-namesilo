    <div class="title_row first">
        <h3><?php $this->_('Dynadot.tab_dnsrecords.title');?></h3>
    </div>
    <div class="pad">
        <div class="alert alert-warning">
            <p><?php $this->_('Dynadot.tab_dnsrecords.warning_overwrite');?></p>
        </div>

        <?php
        $this->Form->create();
        ?>
        <table class="table">
            <thead>
                <tr class="heading_row">
                    <td><?php $this->_('Dynadot.dnsrecord.record_type');?></td>
                    <td><?php $this->_('Dynadot.dnsrecord.host');?></td>
                    <td><?php $this->_('Dynadot.dnsrecord.value');?></td>
                </tr>
            </thead>
            <tbody>
                <?php
                // Show 5 empty rows for setting new records
                for ($i=0; $i<5; $i++) {
                ?>
                <tr>
                    <td>
                        <?php $this->Form->fieldSelect('main_record_type' . $i, $vars->record_types ?? [], $vars->{'main_record_type' . $i} ?? null, ['class' => 'block']); ?>
                    </td>
                    <td>
                        <?php $this->Form->fieldText('subdomain' . $i, $vars->{'subdomain' . $i} ?? '', ['class' => 'block']); ?>
                    </td>
                    <td>
                        <?php $this->Form->fieldText('main_record' . $i, $vars->{'main_record' . $i} ?? '', ['class' => 'block']); ?>
                    </td>
                </tr>
                <?php
                }
                ?>
            </tbody>
        </table>
        <div class="button_row">
            <?php $this->Form->fieldSubmit('save', $this->_('Dynadot.tab_dnsrecords.field_submit', true), ['class' => 'btn btn-primary pull-right']); ?>
        </div>
        <?php
        $this->Form->end();
        ?>
    </div>
