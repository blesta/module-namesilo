<?php /** @var View $this **/ ?>

<div id="ds-records">
    <h6 class="form-section-header first"><?php $this->_('Namesilo.tab_dnssec.title_disclaimer'); ?></h6>
    <p class="text-warning"><?php $this->_('Namesilo.tab_dnssec.warning_message1'); ?></p>
    <p class="text-warning"><?php $this->_('Namesilo.tab_dnssec.warning_message2'); ?></p>

    <h6 class="form-section-header"><?php $this->_('Namesilo.tab_dnssec.title_list'); ?></h6>
    <table class="table">
        <thead>
            <tr>
                <th><span><?php $this->_('Namesilo.dnssec.key_tag'); ?></span></th>
                <th><span><?php $this->_('Namesilo.dnssec.algorithm'); ?></span></th>
                <th><span><?php $this->_('Namesilo.dnssec.digest_type'); ?></span></th>
                <th><span><?php echo $this->_('Namesilo.dnssec.digest'); ?></span></th>
                <th><span><?php $this->_('Namesilo.tab_dnssec.field_delete'); ?></span></th>
            </tr>
        </thead>
        <?php if (!empty($vars->records) && count($vars->records) > 0 && $vars->records[0]) {
            foreach ($vars->records as $record) { ?>
        <!-- List existing ds records -->
        <tbody>
            <tr>
                <td><?php echo $this->Html->safe($record->keyTag ?? null); ?></td>
                <td><?php echo $this->Html->safe($record->algorithm ?? null); ?></td>
                <td><?php echo $this->Html->safe($record->digestType ?? null); ?></td>
                <td><?php echo $this->Html->safe($record->digest ?? null); ?></td>
                <td>
                    <?php
                    $this->Form->create(
                        $this->base_uri .
                            'clients/servicetab/' .
                            ($client_id ?? null) .
                            '/' .
                            ($service_id ?? null) .
                            '/tabDnssec/',
                    );

                    $this->Form->fieldHidden('digest', $record->digest ?? null);
                    $this->Form->fieldHidden('keyTag', $record->keyTag ?? null);
                    $this->Form->fieldHidden('algorithm', $record->algorithm ?? null);
                    $this->Form->fieldHidden('digestType', $record->digestType ?? null);

                    $button_attributes = [
                        'class' => 'btn btn-sm btn-outline-danger',
                        'value' => 'deleteDnssec',
                        'type' => 'submit',
                    ];

                    $this->Form->fieldButton(
                        'action',
                        $this->_('Namesilo.tab_dnssec.field_delete', true),
                        $button_attributes,
                    );

                    $this->Form->end();
                    ?>
                </td>
            </tr>
        </tbody>
            <?php }
        } ?>
    </table>

    <h6 class="form-section-header"><?php $this->_('Namesilo.tab_dnssec.title_add'); ?></h6>
                    <?php $this->Form->create(
                        $this->base_uri .
                            'clients/servicetab/' .
                            ($client_id ?? null) .
                            '/' .
                            ($service_id ?? null) .
                            '/tabDnssec/',
                    ); ?>
    <table class="table">
        <!-- Add New DS Record -->
        <thead>
            <tr>
                <th><span><?php $this->_('Namesilo.dnssec.key_tag'); ?></span></th>
                <th><span><?php $this->_('Namesilo.dnssec.algorithm'); ?></span></th>
                <th><span><?php $this->_('Namesilo.dnssec.digest_type'); ?></span></th>
                <th><span><?php echo $this->_('Namesilo.dnssec.digest'); ?></span></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><?php $this->Form->fieldText('keyTag', '', ['class' => 'form-control']); ?></td>
                <td><?php $this->Form->fieldSelect('algorithm', $vars->selects['algorithm']['options'], '', [
                    'class' => 'form-select',
                ]); ?></td>
                <td><?php $this->Form->fieldSelect('digestType', $vars->selects['digest_type']['options'], '', [
                    'class' => 'form-select',
                ]); ?></td>
                <td><?php $this->Form->fieldText('digest', '', ['class' => 'form-control']); ?></td>
            </tr>
        </tbody>
    </table>
    <div class="d-flex justify-content-end">
        <?php
        $button_attributes = [
            'class' => 'btn btn-primary',
            'value' => 'addDnssec',
            'type' => 'submit',
        ];

        $this->Form->fieldButton('action', $this->_('Namesilo.tab_dnssec.field_add', true), $button_attributes);
        ?>
    </div>
                    <?php $this->Form->end(); ?>
</div>
