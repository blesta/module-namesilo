    <div class="title_row first">
        <h3><?php $this->_('Dynadot.tab_dnssec.title');?></h3>
    </div>
    <div class="pad">
        <div class="links_row">
            <a class="btn btn-default pull-right btn-sm" href="<?php echo $this->Html->safe($this->base_uri . 'clients/servicetab/' . (isset($client_id) ? $client_id : null) . '/' . (isset($service_id) ? $service_id : null) . '/tabDnssec/?action=add');?>"><span><?php $this->_('Dynadot.tab_dnssec.field_add');?></span></a>
        </div>
        <table class="table">
            <thead>
                <tr class="heading_row">
                    <td><?php $this->_('Dynadot.dnssec.key_tag');?></td>
                    <td><?php $this->_('Dynadot.dnssec.algorithm');?></td>
                    <td><?php $this->_('Dynadot.dnssec.digest_type');?></td>
                    <td><?php $this->_('Dynadot.dnssec.digest');?></td>
                    <td><?php $this->_('Dynadot.tab_dnssec.field_delete');?></td>
                </tr>
            </thead>
            <tbody>
                <?php
                if (isset($vars->records) && is_array($vars->records)) {
                    foreach ($vars->records as $record) {
                        ?>
                        <tr>
                            <td><?php echo $this->Html->safe($record->key_tag ?? '');?></td>
                            <td><?php echo $this->Html->safe($record->algorithm ?? '');?></td>
                            <td><?php echo $this->Html->safe($record->digest_type ?? '');?></td>
                            <td><?php echo $this->Html->safe($record->digest ?? '');?></td>
                            <td>
                                <?php
                                $this->Form->create($this->base_uri . 'clients/servicetab/' . (isset($client_id) ? $client_id : null) . '/' . (isset($service_id) ? $service_id : null) . '/tabDnssec/');
                                $this->Form->fieldHidden('action', 'delete');
                                // We need all params to delete
                                $this->Form->fieldHidden('key_tag', $record->key_tag ?? '');
                                $this->Form->fieldHidden('algorithm', $record->algorithm ?? '');
                                $this->Form->fieldHidden('digest_type', $record->digest_type ?? '');
                                $this->Form->fieldHidden('digest', $record->digest ?? '');
                                $this->Form->fieldButton('submit', $this->_('Dynadot.tab_dnssec.field_delete', true), ['class' => 'btn btn-sm btn-danger', 'type' => 'submit']);
                                $this->Form->end();
                                ?>
                            </td>
                        </tr>
                        <?php
                    }
                }
                ?>
            </tbody>
        </table>

        <?php if (isset($vars->add_view) && $vars->add_view) { ?>
        <hr />
        <h4><?php $this->_('Dynadot.tab_dnssec.title_add');?></h4>
        <?php $this->Form->create($this->base_uri . 'clients/servicetab/' . (isset($client_id) ? $client_id : null) . '/' . (isset($service_id) ? $service_id : null) . '/tabDnssec/'); ?>
        <?php $this->Form->fieldHidden('action', 'add'); ?>
        <ul>
            <li>
                <?php $this->Form->label($this->_('Dynadot.dnssec.key_tag', true), 'key_tag'); ?>
                <?php $this->Form->fieldText('key_tag', $vars->key_tag ?? '', ['class' => 'block']); ?>
            </li>
            <li>
                <?php $this->Form->label($this->_('Dynadot.dnssec.algorithm', true), 'algorithm'); ?>
                <?php $this->Form->fieldSelect('algorithm', $vars->algorithms ?? [], $vars->algorithm ?? null, ['class' => 'block']); ?>
            </li>
            <li>
                <?php $this->Form->label($this->_('Dynadot.dnssec.digest_type', true), 'digest_type'); ?>
                <?php $this->Form->fieldSelect('digest_type', $vars->digest_types ?? [], $vars->digest_type ?? null, ['class' => 'block']); ?>
            </li>
            <li>
                <?php $this->Form->label($this->_('Dynadot.dnssec.digest', true), 'digest'); ?>
                <?php $this->Form->fieldText('digest', $vars->digest ?? '', ['class' => 'block']); ?>
            </li>
        </ul>
        <div class="button_row">
            <?php $this->Form->fieldSubmit('save', $this->_('Dynadot.tab_dnssec.field_add', true), ['class' => 'btn btn-primary pull-right']); ?>
        </div>
        <?php $this->Form->end(); ?>
        <?php } ?>
    </div>
