    <div class="title_row first">
        <h3><?php $this->_('Dynadot.tab_email_forwarding.title');?></h3>
    </div>
    <div class="pad">
        <div class="alert alert-warning">
            <p><?php $this->_('Dynadot.tab_email_forwarding.warning_overwrite');?></p>
        </div>

        <?php
        $this->Form->create();
        ?>
        <table class="table">
            <thead>
                <tr class="heading_row">
                    <td><?php $this->_('Dynadot.email_forwarding.username');?></td>
                    <td><?php $this->_('Dynadot.email_forwarding.destination');?></td>
                </tr>
            </thead>
            <tbody>
                <?php
                // Show 5 empty rows
                for ($i=0; $i<5; $i++) {
                ?>
                <tr>
                    <td>
                        <?php $this->Form->fieldText('username' . $i, $vars->{'username' . $i} ?? '', ['class' => 'block']); ?>
                    </td>
                    <td>
                        <?php $this->Form->fieldText('exist_email' . $i, $vars->{'exist_email' . $i} ?? '', ['class' => 'block']); ?>
                    </td>
                </tr>
                <?php
                }
                ?>
            </tbody>
        </table>
        <div class="button_row">
            <?php $this->Form->fieldSubmit('save', $this->_('Dynadot.tab_email_forwarding.field_submit', true), ['class' => 'btn btn-primary pull-right']); ?>
        </div>
        <?php
        $this->Form->end();
        ?>
    </div>
