    <div class="title_row first">
        <h3><?php $this->_('Dynadot.tab_hosts.title');?></h3>
    </div>
    <div class="pad">
        <?php
        $this->Form->create();
        ?>
        <table class="table">
            <thead>
                <tr class="heading_row">
                    <td><?php $this->_('Dynadot.tab_hosts.field_hostname');?></td>
                    <td><?php $this->_('Dynadot.tab_hosts.field_ip');?></td>
                    <td><?php $this->_('Dynadot.tab_hosts.field_submit');?></td>
                </tr>
            </thead>
            <tbody>
                <?php
                if (isset($vars->hosts) && is_array($vars->hosts)) {
                    foreach ($vars->hosts as $host) {
                        ?>
                        <tr>
                            <td><?php echo $this->Html->safe($host->host ?? '');?></td>
                            <td><?php echo $this->Html->safe($host->ip ?? '');?></td>
                            <td>
                                <a href="<?php echo $this->Html->safe($this->base_uri . 'clients/servicetab/' . (isset($client_id) ? $client_id : null) . '/' . (isset($service_id) ? $service_id : null) . '/tabHosts/?action=delete&host=' . ($host->host ?? ''));?>" class="btn btn-sm btn-danger"><?php $this->_('Dynadot.tab_hosts.field_delete');?></a>
                            </td>
                        </tr>
                        <?php
                    }
                }
                ?>
                <tr>
                    <td>
                        <?php $this->Form->fieldText('host', $vars->new_host ?? '', ['class' => 'block']); ?>
                    </td>
                    <td>
                        <?php $this->Form->fieldText('ip', $vars->new_ip ?? '', ['class' => 'block']); ?>
                    </td>
                    <td>
                        <?php $this->Form->fieldSubmit('save', $this->_('Dynadot.tab_hosts.field_add', true), ['class' => 'btn btn-primary']); ?>
                    </td>
                </tr>
            </tbody>
        </table>
        <?php
        $this->Form->end();
        ?>
    </div>
