
	<?php
	$this->Form->create();
	?>
	<div class="pad">
		<ul>
			<li>
				<?php
				$this->Form->label($this->_('Dynadot.tab_settings.field_registrar_lock', true), 'registrar_lock');

				$this->Form->fieldRadio('registrar_lock', 'yes', $this->Html->ifSet($vars->registrar_lock) == 'yes' || $this->Html->ifSet($vars->registrar_lock) == 'true', ['id' => 'registrar_lock_yes']);
				$this->Form->label($this->_('Dynadot.tab_settings.field_registrar_lock_yes', true), 'registrar_lock_yes', ['class' => 'inline']);

				$this->Form->fieldRadio('registrar_lock', 'no', $this->Html->ifSet($vars->registrar_lock) == 'no' || $this->Html->ifSet($vars->registrar_lock) == 'false', ['id' => 'registrar_lock_no']);
				$this->Form->label($this->_('Dynadot.tab_settings.field_registrar_lock_no', true), 'registrar_lock_no', ['class' => 'inline']);
				?>
			</li>
			<li>
				<?php
				$this->Form->label($this->_('Dynadot.tab_settings.field_request_epp', true), 'request_epp');
				$this->Form->fieldCheckbox('request_epp', 'true', $this->Html->ifSet($vars->request_epp) == 'true', ['id' => 'request_epp']);
				?>
			</li>
		</ul>
	</div>
	<div class="button_row">
		<?php
		$this->Form->fieldSubmit('save', $this->_('Dynadot.tab_settings.field_submit', true), ['class' => 'btn btn-primary pull-right']);
		?>
	</div>
	<?php
	$this->Form->end();
	?>
